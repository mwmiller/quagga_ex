#!/usr/bin/env bash
set -e

# Deploy BOTH nodes hosted by this repo, in one go:
#
#   quagga -> baobab volume in ord (USA / Chicago) -> quagga.zebrine.net
#   dazzle -> baobab volume in jnb (Johannesburg)  -> dazzle.zebrine.net
#
# Each machine lands in the region its `baobab` volume was created in, so no
# --region flag is needed/accepted by `fly deploy`.
#
# Prerequisites (handled once, on the fly.io side):
#   fly apps create quagga
#   fly apps create dazzle
#   fly volumes create baobab --app quagga --region ord --size 10
#   fly volumes create baobab --app dazzle --region jnb --size 10
#   fly secrets set QUAGGA_SECRET_KEY=... --app quagga
#   fly secrets set DAZZLE_SECRET_KEY=... --app dazzle
#   (plus the DNS mappings for *.zebrine.net)
#
# QUAGGA_FRESH_ANNOUNCE tells the Nicker whether this boot is a brand-new
# identity (safe to announce at sequence number 1) or a recovered one (wait for
# its old oasis logs to return from the peer, preventing a fork). The safe
# default is "recovered"; pass --fresh only on the FIRST boot of a new
# identity/key:
#   ./deploy_all --fresh
# Every later deploy / redeploy just runs ./deploy_all (no --fresh), and the
# node pulls its old logs back before writing.
#
# To deploy a single node instead, use ./deploy_latest <app> [--fresh].

FRESH=""
for arg in "$@"; do
  case "$arg" in
    --fresh) FRESH="--env QUAGGA_FRESH_ANNOUNCE=1" ;;
    *) echo "Unknown argument: $arg" >&2; exit 1 ;;
  esac
done

git stash
git fetch --prune origin
git reset --hard origin/main
git stash pop || true

# shellcheck disable=SC2086
fly deploy --app quagga $FRESH
# shellcheck disable=SC2086
fly deploy --app dazzle $FRESH
